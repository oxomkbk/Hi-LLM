{
  "name": "hillm-nav",
  "type": "module",
  "version": "3.7.1",
  "private": true,
  "description": "HiLLM NAV 是一个面向 AI 工具、Skills、MCP 与 Prompts 的开源导航和社区平台。",
  "author": {
    "name": "oxomkbk",
    "url": "https://github.com/oxomkbk"
  },
  "homepage": "https://github.com/oxomkbk/Hi-LLM#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxomkbk/Hi-LLM.git"
  },
  "bugs": {
    "url": "https://github.com/oxomkbk/Hi-LLM/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ai-security-db": "node --env-file=.env scripts/ai-security-db-smoke.mjs",
    "test:ai-security-scanner": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s security/scanner-service -p 'test_*.py' -v",
    "test:wonderland-db": "node --env-file=.env scripts/wonderland-admin-smoke.mjs",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts all",
    "db:migrate:control": "tsx --env-file=.env scripts/migrate.ts control",
    "db:migrate:business": "tsx --env-file=.env scripts/migrate.ts business",
    "db:seed:terminology": "node --conditions=react-server --env-file=.env --import tsx scripts/seed-development-terminology.ts",
    "security:gateway": "node --conditions=react-server --env-file=.env --import tsx scripts/ai-security-gateway.ts",
    "security:backfill": "node --conditions=react-server --env-file=.env --import tsx scripts/backfill-security-assessments.ts",
    "security:deep:status": "docker compose --profile security --profile security-deep ps security-gateway security-scanner security-worker",
    "security:deep:up": "docker compose --profile security --profile security-deep up -d security-gateway security-scanner security-worker",
    "security:stack:status": "docker compose --profile security ps security-worker",
    "security:stack:up": "docker compose --profile security up -d security-worker",
    "security:worker:check": "node --conditions=react-server --env-file=.env --import tsx scripts/ai-security-worker.ts --check",
    "security:worker": "node --conditions=react-server --env-file=.env --import tsx scripts/ai-security-worker.ts"
  },
  "dependencies": {
    "@bprogress/next": "^3.2.12",
    "@heroui/react": "3.2.3",
    "@heroui/styles": "3.2.3",
    "@next/third-parties": "^16.2.9",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-code-block-lowlight": "^3.30.1",
    "@tiptap/extension-highlight": "^3.30.5",
    "@tiptap/extension-image": "^3.30.1",
    "@tiptap/extension-list": "^3.30.1",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/extension-text-align": "^3.30.5",
    "@tiptap/extension-text-style": "^3.30.1",
    "@tiptap/markdown": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "1.6.26",
    "cos-nodejs-sdk-v5": "3.0.0",
    "i18n-jsautotranslate": "4.0.0",
    "lowlight": "^3.3.0",
    "motion": "^12.42.2",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "postcss": "^8.5.25",
    "postcss-selector-parser": "^7.1.4",
    "postcss-value-parser": "^4.2.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-easy-crop": "^6.1.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.7",
    "server-only": "0.0.1",
    "sharp": "0.35.3",
    "tsx": "4.23.12",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.2.0",
    "@eslint-react/eslint-plugin": "^5.18.1",
    "@gravity-ui/icons": "^2.20.0",
    "@next/eslint-plugin-next": "16.2.9",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^26.0.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.15.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-refresh": "^0.5.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  }
}
