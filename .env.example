# 固定本地控制面 PostgreSQL：认证、配置、上传会话与安全审计
CONTROL_DATABASE_URL=postgresql://hillm_nav:hillm_nav@127.0.0.1:5433/hillm_nav_control
# 初次启动使用的业务 PostgreSQL；之后可在后台切换 Profile
BUSINESS_DATABASE_URL=postgresql://hillm_nav:hillm_nav@127.0.0.1:5434/hillm_nav_business
# Better Auth 根密钥与配置认证加密密钥，生产环境必须使用独立的高熵值
AUTH_SECRET=
CONFIG_ENCRYPTION_KEY=
BETTER_AUTH_URL=http://localhost:3000
# 生产认证限流必须成对配置；代理需覆盖此 Header，并仅允许下列代理网段直连源站
AUTH_IP_HEADER=
AUTH_TRUSTED_PROXY_CIDRS=

# 邮箱验证与密码重置
# 本地可使用 console（验证链接输出到服务端终端）；生产环境必须改为 smtp
AUTH_EMAIL_MODE=console
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# OAuth（仅在 ID 和 Secret 同时存在时启用）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 本地文件 Provider；生产环境必须使用持久磁盘的绝对路径
LOCAL_STORAGE_ROOT=.data/storage
# 首次安装的一次性管理员 UUID；授权成功后从环境删除
BOOTSTRAP_ADMIN_USER_ID=

# 可选的独立匿名访问哈希盐；建议生产环境设置 32 字节以上随机值，未设置时复用 AUTH_SECRET
SUBMISSION_IP_HASH_SALT=
# 仅在可信反向代理后启用
TRUST_PROXY_HEADERS=false
# 妙妙屋定时新闻发布任务的 Bearer Token（生产环境必须设置）
CRON_SECRET=
# 非 Vercel 环境如需接入 Vercel Analytics，可显式开启
NEXT_PUBLIC_VERCEL_ANALYTICS=false

# AI 安全评测 Worker；并发上限只收紧后台设置（后台允许 1-4）
AI_SECURITY_WORKER_ID=
AI_SECURITY_WORKER_CONCURRENCY_CAP=4
# Linux 宿主机会自动检测固定 Worker systemd 单元与严格 sudoers 权限。
# 仅在需要紧急关闭后台节点控制时设为 true。
AI_SECURITY_WORKER_CONTROL_DISABLED=false
# 默认仅执行本地确定性规则，不把评测内容发送给 LLM 或深度扫描器。
# 明确完成数据外发授权后，才可改为 false 启用 AI 辅助评审。
AI_SECURITY_LOCAL_ONLY=true
# 可选的隔离深度扫描器；留空时 Skills 自动使用平台内置静态评测。
# 启用 security:deep:up 时，共享密钥必须使用独立高熵值。
AI_SECURITY_SCANNER_URL=
AI_SECURITY_SCANNER_SHARED_SECRET=
# Scanner 与内部 Gateway 必须使用后台已确认的同一个固定模型
AI_SECURITY_SCANNER_MODEL=
AI_SECURITY_GATEWAY_LISTEN_HOST=127.0.0.1
AI_SECURITY_GATEWAY_LISTEN_PORT=8092
# 可选：提高公开仓库 API 限额。首版仅用于 github.com / gitlab.com 固定 API。
AI_SECURITY_GITHUB_TOKEN=
AI_SECURITY_GITLAB_TOKEN=

# 项目名称
NEXT_PUBLIC_APP_NAME=HiLLM NAV
# 副标题
NEXT_PUBLIC_APP_TITLE=发现、收藏并分享值得访问的 AI 工具
# 项目描述
NEXT_PUBLIC_APP_DESC=AI 工具、Skills、MCP 与 Prompts 的开源导航和社区平台。
# 项目关键词
NEXT_PUBLIC_APP_KEYWORDS=HiLLM NAV,AI 工具,Skills,MCP,Prompts,网址导航
# 项目域名
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 迁移期旧文件公开地址前缀；全部迁移后可删除
NEXT_PUBLIC_LEGACY_STORAGE_PUBLIC_URL=
# 作者信息（可选）
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_AUTHOR_ROLE=
# 备案信息（可选）
NEXT_PUBLIC_ICP=
NEXT_PUBLIC_GUAN_ICP=
# Google ID
NEXT_PUBLIC_GOOGLE_ID=
# Clarity ID
NEXT_PUBLIC_CLARITY_ID=
