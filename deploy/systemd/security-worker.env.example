NODE_ENV=production
BUSINESS_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5434/hillm_nav_business
CONTROL_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/hillm_nav_control
CONFIG_ENCRYPTION_KEY=

AI_SECURITY_LOCAL_ONLY=true
AI_SECURITY_WORKER_CONCURRENCY_CAP=4
AI_SECURITY_WORKER_ID=hillm-security-worker-production

# 仅在已授权内容外发并启用隔离 Scanner 时填写。
AI_SECURITY_SCANNER_URL=
AI_SECURITY_SCANNER_SHARED_SECRET=
AI_SECURITY_SCANNER_MODEL=

# 可选：提高公开仓库 API 限额。
AI_SECURITY_GITHUB_TOKEN=
AI_SECURITY_GITLAB_TOKEN=
